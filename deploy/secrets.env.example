# Copy to deploy/secrets.env (gitignored). Every key here is set as a secret
# environment variable on the container. Values are taken literally (no shell
# expansion), so `$` in ADMIN_PASSWORD_HASH is fine.
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
S3_ENDPOINT=https://s3.fr-par.scw.cloud
S3_REGION=fr-par
S3_BUCKET=
S3_WEB_URL=
# API key of an IAM application with Object Storage object read/write/delete
# in the project of the bucket.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Serverless SQL: user = an IAM application's ID (not the access key),
# password = that application's API secret key (may be a different application
# than the S3 key). Needs ServerlessSQLDatabaseFullAccess: ReadWrite cannot
# CREATE TABLE, which the app does at startup.
DB_USER=
DB_PASSWORD=
