# Non-secret deployment settings (committed). Secrets go in deploy/secrets.env.
REGION=fr-par
# Registry namespace names are globally unique within a region; change if taken.
REGISTRY_NAMESPACE=auksjon
IMAGE_NAME=auksjon
CONTAINER_NAMESPACE=auksjon
CONTAINER_NAME=auksjon
DB_NAME=auksjon
DB_CPU_MAX=4
# Custom hostname, e.g. auksjon.example.no. Create a CNAME to the container
# endpoint (printed by deploy.sh) before setting this.
DOMAIN=
# min 1 avoids JVM cold starts (~€6/month at 512 MB / 280 mvCPU after free tier).
MIN_SCALE=1
MAX_SCALE=2
MEMORY_MB=512
MVCPU=280
